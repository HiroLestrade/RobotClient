<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Must match ForceEstimation: GeomagicCore.dll is a Win32 (x86) native DLL. -->
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForceEstimation\ForceEstimation.csproj" />
  </ItemGroup>

  <!--
    The native DLLs are copied into ForceEstimation's output by custom targets, so
    they are not tracked as project outputs and do not flow through the
    ProjectReference. RobotClient is the startup exe, so it needs its own copies
    next to it.
  -->
  <Target Name="CopyNativeDlls" AfterTargets="Build">
    <ItemGroup>
      <NativeDll Include="$(MSBuildProjectDirectory)\..\..\GeomagicCore\$(Configuration)\GeomagicCore.dll" />
      <NativeDll Include="$(MSBuildProjectDirectory)\..\..\ATIForceSensor\$(Configuration)\ATIForceSensor.dll" />
      <NativeDll Include="$(MSBuildProjectDirectory)\..\..\ViperCore\ViperCore\dxl_x86_c.dll" />
    </ItemGroup>
    <!-- A missing source raises MSB3030 as a warning; the build still succeeds and
         the DllNotFoundException only shows up at run time. -->
    <Copy SourceFiles="@(NativeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
